#include "resource.h"
#include <windows.h>
#include <commctrl.h>
#pragma code_page(65001)

IDD_TABLE DIALOGEX 0, 0, 430, 220
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Таблиця об’єктів"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SHAPES, "SysListView32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 7, 7, 416, 182
    PUSHBUTTON "Видалити вибране", IDC_DELETE_SHAPE, 7, 196, 100, 17, WS_TABSTOP
    PUSHBUTTON "Закрити", IDCANCEL, 353, 196, 70, 17, WS_TABSTOP
END
IDB_TOOL_DOT BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/resources/dot.bmp"
IDB_TOOL_LINE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/resources/line.bmp"
IDB_TOOL_RECT BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/resources/rectangle.bmp"
IDB_TOOL_ELLIPSE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/resources/ellipse.bmp"
IDB_TOOL_CIRCLE_LINE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/resources/circle-line.bmp"
IDB_TOOL_CUBE BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/resources/cube.bmp"
